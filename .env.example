# Copy these into Netlify: Site configuration > Environment variables
# (never commit a real .env file with actual keys to git)

# Stripe — dashboard.stripe.com/apikeys (use the "sk_test_..." key while testing)
STRIPE_SECRET_KEY=sk_test_xxx

# Created after you add the webhook endpoint in the Stripe dashboard (see README)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase — project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Printful — developers.printful.com, create a Private Token for your store
PRINTFUL_API_KEY=your-printful-token
PRINTFUL_STORE_ID=your-store-id

# Your live domain once it's connected (used to build Stripe's redirect URLs)
SITE_URL=https://barkho.com
